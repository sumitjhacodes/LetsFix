{
  "name": "letsfix",
  "displayName": "LetsFix",
  "description": "Explain and fix failed terminal commands with your own API key — OpenAI, Claude, Gemini, Grok, Kimi, and more",
  "version": "1.1.0",
  "publisher": "SumitJha2002",
  "license": "MIT",
  "icon": "assets/LetsFix.png",
  "galleryBanner": {
    "color": "#0B0B0B",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "keywords": [
    "letsfix",
    "terminal",
    "shell",
    "error",
    "explain",
    "fix",
    "command",
    "ai",
    "llm",
    "openai",
    "claude",
    "gemini",
    "grok",
    "kimi",
    "debugging"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "fixit.explainLastError",
        "title": "LetsFix: Explain Last Error"
      },
      {
        "command": "fixit.fixLastError",
        "title": "LetsFix: Fix Last Error"
      },
      {
        "command": "fixit.explainSelection",
        "title": "LetsFix: Explain Selection"
      },
      {
        "command": "fixit.setApiKey",
        "title": "LetsFix: Set API Key"
      },
      {
        "command": "fixit.chooseProvider",
        "title": "LetsFix: Choose AI Provider"
      },
      {
        "command": "fixit.setModel",
        "title": "LetsFix: Set Model"
      }
    ],
    "keybindings": [
      {
        "command": "fixit.explainLastError",
        "key": "ctrl+alt+e",
        "mac": "cmd+alt+e"
      },
      {
        "command": "fixit.fixLastError",
        "key": "ctrl+alt+f",
        "mac": "cmd+alt+f"
      }
    ],
    "configuration": {
      "title": "LetsFix",
      "properties": {
        "fixit.provider.id": {
          "type": "string",
          "default": "openai",
          "enum": [
            "openai",
            "anthropic",
            "google",
            "groq",
            "xai",
            "moonshot",
            "openrouter",
            "custom"
          ],
          "enumDescriptions": [
            "OpenAI GPT models",
            "Anthropic Claude (native API)",
            "Google Gemini (native API)",
            "Groq OpenAI-compatible",
            "xAI Grok OpenAI-compatible",
            "Moonshot / Kimi OpenAI-compatible",
            "OpenRouter (many models via one key)",
            "Any custom OpenAI-compatible base URL"
          ],
          "description": "Which AI provider LetsFix should call."
        },
        "fixit.provider.baseUrl": {
          "type": "string",
          "default": "https://api.openai.com/v1",
          "description": "API base URL. Auto-filled when you pick a provider; override for Custom endpoints."
        },
        "fixit.provider.model": {
          "type": "string",
          "default": "gpt-4o-mini",
          "description": "Model id (e.g. gpt-4o-mini, claude-sonnet-4-5, gemini-2.0-flash, grok-2-latest)."
        },
        "fixit.maxOutputChars": {
          "type": "number",
          "default": 12000,
          "minimum": 1000,
          "maximum": 100000,
          "description": "Maximum characters of terminal output to send to the model."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --no-dependencies --allow-missing-repository",
    "lint": "tsc -p ./ --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.93.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.5.0"
  }
}
